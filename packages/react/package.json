{
  "name": "@orchard-ui/react",
  "version": "0.0.0",
  "description": "Premium React component library inspired by Apple's Human Interface Guidelines",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@orchard-ui/primitives": "workspace:*",
    "@orchard-ui/tokens": "workspace:*",
    "@react-aria/combobox": "^3.16.1",
    "@react-aria/interactions": "^3.28.1",
    "@react-aria/listbox": "^3.16.1",
    "@react-aria/menu": "^3.22.1",
    "@react-aria/overlays": "^3.32.1",
    "@react-aria/tabs": "^3.12.1",
    "@react-aria/tooltip": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@react-stately/combobox": "^3.14.1",
    "@react-stately/list": "^3.14.1",
    "@react-stately/menu": "^3.10.1",
    "@react-stately/tabs": "^3.9.1",
    "@react-stately/tooltip": "^3.6.1",
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/recipes": "^0.5.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@orchard-ui/eslint-config": "workspace:*",
    "@orchard-ui/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vanilla-extract/esbuild-plugin": "^2.3.14",
    "@vanilla-extract/vite-plugin": "^4.0.19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
